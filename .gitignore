# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Test coverage (xp-gate pre-commit hook reads coverage/coverage-summary.json)
coverage/

# Local (non-authoritative) bench baseline recorded on a dev machine
bench/baseline.local.json

# Local runtime state (gateway pid/log/state)
.llmveto/

# Local runtime state & scratch under var/ (compiled binaries, logs, tmp, evidence).
# Evidence store may contain sensitive request metadata — never commit. Only *.ts sources are tracked.
var/*
!var/*.ts

# Sprint worktrees (isolated dev branches)
.worktrees/

# xp-gate hook artifacts (local quality-gate reports/history, not project state)
.xp-gate/
.quality-history.jsonl

# Agent harness residue (local run continuation state, not project state)
.omo/

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
.qoder/

# Secrets — the gateway scans for these, it must never store them
.env
.env.*
!.env.example
*.pem
*.key
