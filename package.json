{
  "name": "llmveto",
  "version": "0.2.0",
  "description": "Local security gateway that vetoes malicious LLM relay traffic — deterministic verification, fail-closed blocking, tamper-evident audit trail.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/boyingliu01/llmveto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boyingliu01/llmveto.git"
  },
  "bugs": {
    "url": "https://github.com/boyingliu01/llmveto/issues"
  },
  "keywords": [
    "llm",
    "security",
    "gateway",
    "proxy",
    "prompt-injection",
    "ai-safety",
    "audit"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.1"
  },
  "bin": {
    "llmveto": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "llmveto": "bun run src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun run src/cli/index.ts start",
    "stop": "bun run src/cli/index.ts stop",
    "status": "bun run src/cli/index.ts status",
    "doctor": "bun run src/cli/index.ts doctor",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:dist": "tsc -p tsconfig.build.json --noEmit",
    "lint": "oxlint src tests",
    "bench:record": "bun run bench/record-baseline.ts",
    "release:gate": "node scripts/release-gate.mjs",
    "prepublishOnly": "npm run release:gate",
    "clean": "rimraf dist coverage"
  },
  "devDependencies": {
    "@archlinter/cli": "^0.17.1",
    "@types/bun": "latest",
    "@types/node": "latest",
    "@vitest/coverage-v8": "latest",
    "oxlint": "latest",
    "rimraf": "^6.1.3",
    "typescript": "latest",
    "vitest": "latest"
  }
}
