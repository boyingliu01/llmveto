--- /dev/null
+++ b/src/gateway/protocols/chat.ts
@@ -0,0 +1,204 @@
+// @no-test-required: 测试在 tests/unit/gateway/protocols/chat.test.ts（含 Chat 对照快照：既有投影逐字节不变）（本项目测试布局为 tests/ 目录；Gate 5a 仅识别同目录/根 tests/ 六种路径）
+import type { CoverageSpec, Projection, WireProtocol } from "./types.ts";
+import { isAuthHeader } from "../scan-unit.ts";
+
+/**
+ * @test REQ-V2bA-04 / AC-V2bA-04a / AC-V2bA-05a
+ * @intent Chat Completions 协议（既有能力的显式化）。
+ *
+ * 本文件与 `scan-unit.ts` 的既有投影**必须逐字节等价**——SL-01 用 chat-baseline.test.ts
+ * 把这条等价关系钉死。它不是"新能力"，而是把既有能力接进注册表，
+ * 让另外两种线格式有一个可对齐的参照物。
+ *
+ * 派生标记：`function_call.arguments` / `tool_calls[].function.arguments` 若以**对象**形态出现，
+ * 会被 JSON.stringify 成文本（原文里没有这段字节）→ derived。字符串形态不派生。
+ */
+
+function pushArguments(args: unknown, out: string[]): "derived" | "verbatim" | "none" {
+  if (typeof args === "string") {
+    out.push(args);
+    return "verbatim";
+  }
+  if (args && typeof args === "object") {
+    out.push(JSON.stringify(args));
+    return "derived";
+  }
+  return "none";
+}
+
+/** content 投影：字符串直取；分段数组取 seg.text（与 scan-unit.pushContentParts 一致）。 */
+function pushContent(content: unknown, out: string[]): void {
+  if (typeof content === "string") {
+    out.push(content);
+    return;
+  }
+  if (!Array.isArray(content)) return;
+  for (const seg of content) out.push(...textOfSegment(seg));
+}
+
+/** 分段数组的一项 → 其 text（非对象 / 无 text 字段则为空）。 */
+function textOfSegment(seg: unknown): string[] {
+  if (!seg || typeof seg !== "object" || !("text" in seg)) return [];
+  return [String((seg as { text: unknown }).text)];
+}
+
+/** function 包裹形态（tool_calls[*].function）；无包裹返回 null。 */
+function fnOf(tc: Record<string, unknown>): Record<string, unknown> | null {
+  const fn = tc.function;
+  return fn && typeof fn === "object" ? (fn as Record<string, unknown>) : null;
+}
+
+/** pushArguments 的三值结果 → 本函数的二值契约。 */
+function derivedOf(result: "derived" | "verbatim" | "none"): "derived" | "none" {
+  if (result === "derived") return "derived";
+  return "none";
+}
+
+/** 工具调用的"载荷源"：有 function 包裹取包裹，扁平形态取工具自身。 */
+function payloadOf(t: Record<string, unknown>): Record<string, unknown> {
+  return fnOf(t) ?? t;
+}
+
+/** 扁平形态的名字挂在工具自身；包裹形态的名字由 payload.name 提供。 */
+function pushToolNames(t: Record<string, unknown>, payload: Record<string, unknown>, out: string[]): void {
+  if (typeof t.name === "string") out.push(t.name);
+  if (payload !== t && typeof payload.name === "string") out.push(payload.name);
+}
+
+function collectToolCall(tc: unknown, out: string[]): "derived" | "none" {
+  if (!tc || typeof tc !== "object") return "none";
+  const t = tc as Record<string, unknown>;
+  const payload = payloadOf(t);
+  pushToolNames(t, payload, out);
+  return derivedOf(pushArguments(payload.arguments, out));
+}
+
+/** 一个 message/delta 盒子里所有工具调用载荷的投影。 */
+function collectToolCalls(b: Record<string, unknown>, out: string[]): boolean {
+  let derived = false;
+  if (Array.isArray(b.tool_calls)) {
+    for (const tc of b.tool_calls) if (collectToolCall(tc, out) === "derived") derived = true;
+  }
+  if (collectToolCall(b.function_call, out) === "derived") derived = true;
+  return derived;
+}
+
+function collectMessageBox(box: unknown, out: string[]): "derived" | "none" {
+  if (!box || typeof box !== "object") return "none";
+  const b = box as Record<string, unknown>;
+  pushContent(b.content, out);
+  const derived = collectToolCalls(b, out);
+  if (typeof b.reasoning_content === "string") out.push(b.reasoning_content);
+  return derived ? "derived" : "none";
+}
+
+/** 请求侧单条消息：投影文本 + 登记 handled（containers / tool_calls / function_call）。 */
+/** 请求侧 message 的 handled 路径（与 collectMessageBox 的可见面一一对应）。 */
+const REQUEST_MESSAGE_HANDLED: ReadonlyMap<string, string> = Object.freeze(
+  new Map([
+    ["content", "messages[].content"],
+    ["tool_calls", "messages[].tool_calls[].function.arguments"],
+    ["function_call", "messages[].function_call.arguments"],
+  ]),
+);
+
+function projectRequestMessage(m: unknown, parts: string[], handled: Set<string>): boolean {
+  if (!m || typeof m !== "object") return false;
+  const mm = m as Record<string, unknown>;
+  for (const [key, path] of REQUEST_MESSAGE_HANDLED) if (mm[key] !== undefined) handled.add(path);
+  return collectMessageBox(mm, parts) === "derived";
+}
+
+/** extra_headers：非认证头进投影（AC-VETO-002-06）；认证头一律排除。 */
+function projectExtraHeaders(extra: unknown, parts: string[]): boolean {
+  if (!extra || typeof extra !== "object") return false;
+  for (const [k, v] of Object.entries(extra as Record<string, unknown>)) {
+    if (isAuthHeader(k)) continue;
+    parts.push(`${k}: ${String(v)}`);
+  }
+  return true;
+}
+
+function projectRequest(parsed: Record<string, unknown>): Projection {
+  const parts: string[] = [];
+  const handled = new Set<string>();
+  let derived = false;
+  if (Array.isArray(parsed.messages)) {
+    derived = projectMessages(parsed.messages, parts, handled);
+  }
+  if (typeof parsed.system === "string") {
+    parts.push(parsed.system);
+    handled.add("system");
+  }
+  if (Array.isArray(parsed.tools)) {
+    parts.push(JSON.stringify(parsed.tools));
+    handled.add("tools");
+    derived = true; // tools 历来以 JSON 文本入投影
+  }
+  if (projectExtraHeaders(parsed.extra_headers, parts)) handled.add("extra_headers");
+  return { parts, derived, handled: [...handled], present: [] };
+}
+
+function projectMessages(msgs: readonly unknown[], parts: string[], handled: Set<string>): boolean {
+  let derived = false;
+  for (const m of msgs) derived = projectRequestMessage(m, parts, handled) || derived;
+  return derived;
+}
+
+/** 响应侧一个 choice 的 message/delta 盒子：投影 + 登记 handled。 */
+/** 响应侧盒子的 handled 路径后缀（与 collectMessageBox 的可见面一一对应）。 */
+const RESPONSE_BOX_HANDLED: readonly string[] = Object.freeze(["content", "tool_calls", "function_call", "reasoning_content"]);
+
+function projectOneBox(key: "message" | "delta", box: unknown, parts: string[], handled: Set<string>): boolean {
+  if (!box || typeof box !== "object") return false;
+  const b = box as Record<string, unknown>;
+  for (const field of RESPONSE_BOX_HANDLED) if (b[field] !== undefined) handled.add(`choices[].${key}.${field}`);
+  return collectMessageBox(b, parts) === "derived";
+}
+
+function projectResponseChoice(c: unknown, parts: string[], handled: Set<string>): boolean {
+  if (!c || typeof c !== "object") return false;
+  const c0 = c as Record<string, unknown>;
+  const d1 = projectOneBox("message", c0.message, parts, handled);
+  const d2 = projectOneBox("delta", c0.delta, parts, handled);
+  return d1 || d2;
+}
+
+function projectResponse(parsed: Record<string, unknown>, _requestedModel: string | null): Projection {
+  const parts: string[] = [];
+  const handled = new Set<string>();
+  let derived = false;
+  if (Array.isArray(parsed.choices)) {
+    for (const c of parsed.choices) derived = projectResponseChoice(c, parts, handled) || derived;
+  }
+  return { parts, derived, handled: [...handled], present: [] };
+}
+
+export const CHAT_COVERAGE: CoverageSpec = Object.freeze({
+  requestPayloadPaths: Object.freeze([
+    "messages[].content",
+    "messages[].tool_calls[].function.arguments",
+    "messages[].function_call.arguments",
+    "system",
+    "tools",
+  ]) as readonly string[],
+  responsePayloadPaths: Object.freeze([
+    "choices[].message.content",
+    "choices[].message.tool_calls[].function.arguments",
+    "choices[].message.function_call.arguments",
+    "choices[].message.reasoning_content",
+    "choices[].delta.content",
+    "choices[].delta.tool_calls[].function.arguments",
+  ]) as readonly string[],
+});
+
+export const chatProtocol: WireProtocol = Object.freeze({
+  format: "chat" as const,
+  coverage: CHAT_COVERAGE,
+  projectRequest,
+  projectResponse,
+  projectFrame(parsed: Record<string, unknown>): Projection {
+    return projectResponse(parsed, null);
+  },
+  canaryInjection: true,
+});
diff --git a/src/gateway/protocols/coverage.ts b/src/gateway/protocols/coverage.ts
new file mode 100644
index 0000000..c1a03b8
--- /dev/null
+++ b/src/gateway/protocols/coverage.ts
@@ -0,0 +1,146 @@
+// @no-test-required: 测试在 tests/unit/gateway/protocols/coverage.test.ts（本项目测试布局为 tests/ 目录；Gate 5a 仅识别同目录/根 tests/ 六种路径）
+import type { CoverageVerdict } from "./types.ts";
+
+/**
+ * @test REQ-V2bA-14（轴2）/ REQ-V2bA-15a
+ * @intent 覆盖判据的**独立 oracle**。
+ *
+ * 为什么需要它（R2 评审 C2）：如果覆盖结论由投影器自己给出，那么"投影器忘了某个字段"
+ * 这件事**永远发现不了**——投影器会照样报告自己覆盖了。所以这里换一个来源：
+ * 用协议声明的 `CoverageSpec` 清单直接在**原始 body** 上求出"存在哪些已知载荷路径"（present），
+ * 再与投影器上报的 handled 求差集。
+ *
+ * 关键性质：结论与**文本量无关**。"凭据藏在未投影字段、其余为空"同样落 partial。
+ */
+
+/**
+ * 只表示"消息容器"的路径：它们存在不等于载荷存在。
+ *
+ * - `input`：Responses 的输入容器。数组非空但元素里没有已知载荷字段（例如只有
+ *   `{type:"message"}`）时，容器"存在"而内容"不可见"——这必须落 vacuous 而不是 full，
+ *   否则"协议已知但什么都没扫到"会被判成已覆盖，正是本判据要消灭的假阴性。
+ *   （`input` 为字符串时它就是载荷，另行处理，见 `hasPath` 的标量分支。）
+ * - `messages` / `output` / `content` 是**载荷字段的父路径**（`messages[].content` 才承载文本），
+ *   同样不单独算载荷。
+ */
+const CONTAINER_PATHS: ReadonlySet<string> = new Set(["input", "messages", "output", "content"]);
+
+/**
+ * 路径段：`messages[].content[].tool_use.input` → ["messages", "content", "tool_use", "input"]。
+ *
+ * 注意 `tool_use` 这类**块类型**也是路径段：Anthropic 的载荷挂在"类型为 tool_use 的块"下面，
+ * 路径必须能表达"数组元素里 type === tool_use 的那一项"。把块类型当成普通的键去查会永远查不到，
+ * 于是清单里声明的路径永远不算 present——覆盖判据就退化成只看顶层容器。
+ */
+function splitPath(path: string): string[] {
+  return path
+    .split(".")
+    .map((seg) => seg.replace(/\[\]$/, ""))
+    .filter((seg) => seg.length > 0);
+}
+
+/** 带数组标记的结果：`messages[].content[].tool_use.input` → [
+ *  {key:"messages", array:true}, {key:"content", array:true}, {key:"tool_use"}, {key:"input"} ]。
+ *  `[]` 必须保留下来——否则 `content[]` 之后的段会当成在对象上找键，而不是在数组元素里找。 */
+export interface PathSegment {
+  readonly key: string;
+  readonly array: boolean;
+}
+
+function splitPathSegments(path: string): PathSegment[] {
+  return path
+    .split(".")
+    .map((raw) => ({ key: raw.replace(/\[\]$/, ""), array: raw.endsWith("[]") }))
+    .filter((seg) => seg.key.length > 0);
+}
+
+/**
+ * 逐段下钻。
+ *
+ * 两条规则是这里唯一容易写错、也必须写对的地方（都在本 sprint 的实测里踩过）：
+ *   ① 段带 `[]` 表示"在数组的每个元素上继续"——**不能**把它当成在对象上找同名键；
+ *   ② 若下一段是**块类型**（`tool_use` 等），只有 `type` 相符的元素才算，
+ *      且块类型段在本层被消费掉（否则 `tool_use` 会被当成一个普通键去查找，永远找不到）。
+ */
+function hasPath(value: unknown, segs: readonly PathSegment[]): boolean {
+  if (segs.length === 0) return value !== undefined;
+
+  // 数组上下文：当前值是一个数组，逐元素在**同一层**继续（不消费段）。
+  // 唯一的例外是"本段是块类型"——它描述数组元素的种类，命中后消费该段。
+  if (Array.isArray(value)) {
+    const head = segs[0]!;
+    if (isBlockType(head.key)) {
+      return value.some((item) => isBlockOfType(item, head.key) && hasPath(item, segs.slice(1)));
+    }
+    return value.some((item) => hasPath(item, segs));
+  }
+
+  if (!value || typeof value !== "object") return false;
+  const [head, ...rest] = segs as [PathSegment, ...PathSegment[]];
+  const child = (value as Record<string, unknown>)[head.key];
+
+  // `key[]`：取到数组后，数组元素按**剩余段**继续。
+  // 元素若本身是块（`{type:"tool_use",...}`），由下一层的"块类型段"分支处理；
+  // 若元素是普通对象（如 message），直接按剩余段取键——两个分支都在数组上下文里完成。
+  if (head.array) {
+    if (!Array.isArray(child)) return false;
+    return child.some((item) => (isBlockOfType(item, rest[0]?.key ?? "") ? hasPath(item, rest.slice(1)) : hasPath(item, rest)));
+  }
+  return hasPath(child, rest);
+}
+
+/** Anthropic content 块的类型名集合（这些词在路径里表示"该 type 的块"，不是普通键）。 */
+const BLOCK_TYPES: ReadonlySet<string> = new Set(["tool_use", "tool_result", "text", "thinking", "image"]);
+
+function isBlockType(seg: string): boolean {
+  return BLOCK_TYPES.has(seg);
+}
+
+/** 该元素是否是给定类型的块。 */
+function isBlockOfType(item: unknown, type: string): boolean {
+  return typeof item === "object" && item !== null && (item as Record<string, unknown>).type === type;
+}
+
+/**
+ * 在原始 body 上求出实际存在的已知载荷路径。
+ * @param specPaths 协议 `CoverageSpec` 里的路径清单
+ * @param body 已解析的原始 JSON
+ */
+export function presentPaths(specPaths: readonly string[], body: unknown): readonly string[] {
+  if (!body || typeof body !== "object") return [];
+  return specPaths.filter((path) => isPayloadPresent(path, body));
+}
+
+/**
+ * 某条载荷路径是否真的承载了内容。
+ *
+ * 容器路径额外要求"数组里至少有一个元素"，且**不**因为数组非空就成立——
+ * 判定交给调用方通过 `input[].xxx` 这类子路径表达；单列 `input` 只在
+ * 它是字符串（Responses 允许 `input: "..."`）时算载荷。
+ */
+function isPayloadPresent(path: string, body: unknown): boolean {
+  if (!CONTAINER_PATHS.has(path)) return hasPath(body, splitPathSegments(path));
+  const value = (body as Record<string, unknown>)[path];
+  if (value === undefined) return false;
+  // 字符串形态的 input 就是载荷本身
+  return typeof value === "string";
+}
+
+/**
+ * 覆盖结论：只看两个集合，**不看文本量**。
+ * @param present 原始 body 里存在的已知载荷路径
+ * @param handled 投影器实际处理过的载荷路径
+ */
+export function coverageVerdict(present: readonly string[], handled: readonly string[]): CoverageVerdict {
+  if (present.length === 0) return "vacuous";
+  const handledSet = new Set(handled);
+  const unhandled = present.filter((p) => !handledSet.has(p));
+  return unhandled.length === 0 ? "full" : "partial";
+}
+
+/** 由覆盖结论给出 evidence 顶层 reason；`full` 不写 reason。 */
+export function coverageReason(present: readonly string[], handled: readonly string[]): "shape_known_empty" | "shape_partial_coverage" | null {
+  const verdict = coverageVerdict(present, handled);
+  if (verdict === "full") return null;
+  return verdict === "vacuous" ? "shape_known_empty" : "shape_partial_coverage";
+}
diff --git a/src/gateway/protocols/outcome.ts b/src/gateway/protocols/outcome.ts
new file mode 100644
index 0000000..35c347b
--- /dev/null
+++ b/src/gateway/protocols/outcome.ts
@@ -0,0 +1,210 @@
+// @no-test-required: 测试在 tests/integration/protocol-outcome.test.ts（本项目测试布局为 tests/ 目录；Gate 5a 仅识别同目录/根 tests/ 六种路径）
+import { coverageReason, coverageVerdict, presentPaths } from "./coverage.ts";
+import { egressSecretScan } from "../../checkers/egress-secret-scan.ts";
+import { protocolFor, recognize } from "./registry.ts";
+import type { CoverageReason, Direction, RecognizedFormat, WireFormat, WireProtocol } from "./types.ts";
+
+type ShapeReason = CoverageReason;
+
+/**
+ * @test REQ-V2bA-14 / REQ-V2bA-15 / REQ-V2bA-15a
+ * @intent 两轴处置：轴1 识别（known / unknown）× 轴2 覆盖（full / partial / vacuous）。
+ *
+ * 为什么分两轴（R2 评审 C2）：上一版把"识别结果"与"覆盖结果"揉成一张四态表，
+ * 结果 `known_but_empty` 不可达、`shape_partial_coverage` 与它重叠、
+ * "零文本但部分未覆盖"落进四态之外。两轴相乘后同一条请求只有一个格。
+ *
+ * 判据是**投影器有没有覆盖已知载荷字段**，不是"文本是不是空的"——
+ * 这条区分让"纯工具调用"（tool_result 本身就是内容字段）正常放行，
+ * 同时让"凭据藏在未投影字段"必然落 partial。
+ */
+
+/** 一次判定的结果：需要阻断时给出 reason，否则 reason 为 null。 */
+export interface ShapeVerdict {
+  readonly format: WireFormat | null;
+  /** 覆盖降级的原因（**无论受管与否都要写**）：不写就等于把降级藏起来。 */
+  readonly reason: CoverageReason | null;
+  /** 是否因此阻断。受管路由恒等于 `reason !== null`；非受管路由恒为 false。 */
+  readonly block: boolean;
+}
+
+const NOTHING: ShapeVerdict = Object.freeze({ format: null, reason: null, block: false });
+
+/**
+ * 判定一个已解析 body 的形状。
+ *
+ * @param direction 请求或响应
+ * @param parsed 已解析 JSON；不可解析传 null（不可解析的 body 由调用方按既有 malformed 路径处理）
+ * @param routePrefix 路由前缀（受管前缀即权威）
+ * @param consoleManaged 该路由是否受管（受管才 fail-closed；非受管只记录）
+ */
+export function shapeVerdict(
+  direction: Direction,
+  parsed: unknown,
+  routePrefix: string | null | undefined,
+  consoleManaged: boolean,
+): ShapeVerdict {
+  const body = asBody(parsed);
+  if (body === null) return NOTHING;
+  const recognized = recognize(direction, body, routePrefix);
+  if (isUnrecognizable(direction, body, recognized)) return unrecognized(recognized, consoleManaged);
+  return recognized.kind === "known" ? judged(recognized.format, direction, body, consoleManaged) : NOTHING;
+}
+
+/**
+ * "认不出"的结论。
+ *
+ * reason **总是**给出（受管与否都一样）：REQ-15 要求"非受管路由同样写 reason，但不阻断"。
+ * 只把阻断与记录分开，不把两者绑在一起——否则非受管路径上的覆盖降级在 evidence 里完全不可见，
+ * 那正是本项目要消灭的形态。
+ */
+function unrecognized(recognized: RecognizedFormat, consoleManaged: boolean): ShapeVerdict {
+  const format = recognized.kind === "known" ? recognized.format : null;
+  return { format, reason: "shape_unrecognized", block: consoleManaged };
+}
+
+/** 已解析 body 的对象视图；不是对象（null / 数组 / 标量）返回 null。 */
+function asBody(parsed: unknown): Record<string, unknown> | null {
+  if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) return null;
+  return parsed as Record<string, unknown>;
+}
+
+/** 识别成功后的处置：有投影器 → 覆盖轴；无投影器 → 覆盖缺失。 */
+function judged(format: WireFormat, direction: Direction, body: Record<string, unknown>, consoleManaged: boolean): ShapeVerdict {
+  const proto = protocolFor(format);
+  // 已识别但本网关没有该格式的投影器：与"认不出来"同属覆盖缺失（原因不同，处置相同）。
+  const reason = proto === undefined ? "shape_unrecognized" : coverageShape(direction, body, proto);
+  return { format, reason, block: consoleManaged && reason !== null };
+}
+
+/** 是否需要判为"认不出"：识别失败，或请求体是个认不出的壳。 */
+function isUnrecognizable(direction: Direction, body: Record<string, unknown>, recognized: RecognizedFormat): boolean {
+  if (recognized.kind === "unknown") return true;
+  return direction === "request" && isUnrecognizableShell(body);
+}
+
+/** 覆盖轴：由 present 与投影器上报的 handled 求差集。 */
+function coverageShape(direction: Direction, body: Record<string, unknown>, proto: WireProtocol): ShapeReason | null {
+  const present = presentFor(direction, body, proto);
+  const projection = projectionFor(direction, body, proto);
+  const coverage = coverageReason(present, projection.handled);
+  // 兜底**必须先于**豁免判定（R3 C1）：豁免的判据是"present 为空或容器为空"，
+  // 而"凭据藏在未登记字段、恰好没有任何载荷字段"正是 present 为空的情形——
+  // 把兜底放在豁免之后就等于给它留了一道门。
+  if (unseenSecret(body, projection.parts.join("\n"))) {
+    return "shape_partial_coverage";
+  }
+  return reasonFor(direction, body, present, coverage);
+}
+
+/**
+ * 协议已知，但 body 里**有凭据形状的内容没被任何投影器看过**。
+ *
+ * 为什么不是"逐字符串比对扫描文本"（第 3/4 轮的写法，都失败了）：
+ *   - 第 3 轮按裸键名豁免 `id`，凭据藏在 `id` 下就看不见；
+ *   - 第 4 轮按值形态判（短标识符 / URL / base64），于是 `url` 键下的、
+ *     大写开头的、35 字符无空白的凭据又都漏了。
+ * 每加一条豁免就多一个绕过面——**判据本身成了攻击面**。
+ *
+ * 现在的做法把顺序倒过来：不管 body 长什么样，**先用既有凭据扫描器扫原始 body 的 JSON 文本**，
+ * 扫到的每一处都必须能在投影文本里找到。找不到 = 这个凭据没有人看过 = 覆盖不足。
+ * 判据就是扫描器自己的规则集，与真正拦截时用的是同一套，不需要猜"哪些字符串像载荷"。
+ */
+function unseenSecret(body: Record<string, unknown>, scannedText: string): boolean {
+  const raw = JSON.stringify(body);
+  const scan = egressSecretScan({ direction: "request", transport: "non-stream", text: raw, meta: {} });
+  if (scan.verdict !== "finding") return false;
+  for (const finding of scan.evidence) {
+    const start = finding.offsets?.[0];
+    if (start === undefined) return true; // 有命中但拿不到位置：按"没看过"处理
+    const token = /^[^\s"',}\]]+/.exec(raw.slice(start));
+    const hit = token === null ? "" : token[0];
+    if (hit.length > 0 && !scannedText.includes(hit)) return true;
+  }
+  return false;
+}
+
+/**
+ * 把"覆盖结论"落到四种情形上（顺序即优先级）：
+ *
+ * 1. **没有消息容器**（只有 `model` 之类元数据）→ 合法空请求，放行。
+ *    注入逻辑本来就把它当"无 user message → inject_skipped"，形状判定没有理由更严。
+ * 2. **容器是空的**（`messages: []`）→ 合法空请求（健康探针、空会话续写），放行。
+ * 3. **容器有元素但一个已知载荷字段都没有**（`messages: [{role:"user"}]`）→ 也是合法空请求；
+ *    canary 注入的"分支 4"正是这种形态，判得比注入更严会把它误杀。
+ * 4. 其余 → 按覆盖结论：`full` 不写 reason；`partial` / `vacuous` 写对应码并阻断。
+ *
+ * 第 3 条是刻意的取舍：它让"攻击者发一个空壳 body"不被判为覆盖缺口。
+ * 代价是"容器在、字段名却全都不认识"这种情况不会单独报码——那属于协议扩面的
+ * 长期工作（REQ-V2bA-15a 的 partial 守卫覆盖了"已知字段未投影"那一半），
+ * 而不是靠形状判定硬猜。
+ */
+function reasonFor(
+  direction: Direction,
+  body: Record<string, unknown>,
+  present: readonly string[],
+  coverage: "shape_known_empty" | "shape_partial_coverage" | null,
+): ShapeReason | null {
+  if (direction !== "request") return coverage;
+  const excused = !hasAnyElement(direction, body) || present.length === 0;
+  return excused ? null : coverage;
+}
+
+/**
+ * 请求体是否是"认不出的壳"：既没有消息容器，正文本身也归类不了。
+ *
+ * 判据必须同时看两件事——
+ *   - `{model:"m"}`（无容器、但正文可归为 chat/空请求）→ **不是**壳，放行；
+ *   - `{totally:"x", model:"m"}`（无容器、正文也认不出）→ 是壳，阻断。
+ * 只看前者会把合法空请求打死；只看后者会让任意陌生 body 借权威前缀蒙混过关。
+ */
+function isUnrecognizableShell(body: Record<string, unknown>): boolean {
+  const hasContainer = hasMessageContainer(body.messages) || hasMessageContainer(body.input) || body.input !== undefined;
+  if (hasContainer) return false;
+  // 只有元数据、没有任何协议特征键：这是"空请求"，不是"壳"。
+  // 与注入逻辑的"无 user message → inject_skipped"同口径——形状判定不得比它更严。
+  if (!hasAnyProtocolSignal(body)) return false;
+  return recognize("request", body, null).kind === "unknown";
+}
+
+/** 正文里是否出现任何一种协议特征键（出现才谈得上"试图冒充某种格式"）。 */
+function hasAnyProtocolSignal(body: Record<string, unknown>): boolean {
+  const signals = ["input", "output", "instructions", "system", "tools", "tool_choice", "choices", "content"];
+  return signals.some((k) => body[k] !== undefined) || typeof body.type === "string";
+}
+
+/** 可读容器里是否至少有一个实际元素（空容器 = 合法空请求）。 */
+function hasAnyElement(direction: Direction, body: Record<string, unknown>): boolean {
+  const containers = direction === "response" ? [body.choices, body.output, body.content] : [body.messages, body.input];
+  return containers.some((c) => Array.isArray(c) ? c.length > 0 : typeof c === "string");
+}
+
+/**
+ * 消息容器**存在**（数组即可，空数组也算）。
+ *
+ * 空数组是"合法空请求"（健康探针、空会话续写），不是"认不出"——
+ * 两者处置相同（受管路由 fail-closed），但判成"认不出"会让运维噪声与协议缺口混在一起。
+ */
+function hasMessageContainer(value: unknown): boolean {
+  return Array.isArray(value);
+}
+
+/** 仅用于测试与审计：暴露某 body 的覆盖结论（不含 fail-closed 决策）。 */
+export function coverageOf(direction: Direction, parsed: unknown): "full" | "partial" | "vacuous" | "unknown" {
+  const body = asBody(parsed);
+  if (body === null) return "unknown";
+  const recognized = recognize(direction, body, null);
+  const proto = recognized.kind === "unknown" ? undefined : protocolFor(recognized.format);
+  if (proto === undefined) return "unknown";
+  return coverageVerdict(presentFor(direction, body, proto), projectionFor(direction, body, proto).handled);
+}
+
+/** 某方向下 body 实际存在的已知载荷路径。 */
+function presentFor(direction: Direction, body: Record<string, unknown>, proto: WireProtocol): readonly string[] {
+  return presentPaths(direction === "request" ? proto.coverage.requestPayloadPaths : proto.coverage.responsePayloadPaths, body);
+}
+
+/** 某方向下协议投影器的产物。 */
+function projectionFor(direction: Direction, body: Record<string, unknown>, proto: WireProtocol) {
+  return direction === "request" ? proto.projectRequest(body) : proto.projectResponse(body, null);
+}
diff --git a/src/gateway/protocols/registry.ts b/src/gateway/protocols/registry.ts
new file mode 100644
index 0000000..3e208d5
--- /dev/null
+++ b/src/gateway/protocols/registry.ts
@@ -0,0 +1,138 @@
+// @no-test-required: 测试在 tests/unit/gateway/protocols/registry.test.ts（含"跨格式相似性"三条回归）（本项目测试布局为 tests/ 目录；Gate 5a 仅识别同目录/根 tests/ 六种路径）
+import type { Direction, RecognizedFormat, WireFormat } from "./types.ts";
+import { protocolFor } from "./table.ts";
+
+/**
+ * @test REQ-V2bA-03 / REQ-V2bA-04 / REQ-V2bA-10
+ * @intent 协议注册表与"路由权威"识别。
+ *
+ * 路由权威的理由（R2 评审 C1，实测）：Claude 的"无 system + 纯文本"请求与 Chat 请求
+ * **在结构上完全相同**，任何纯内容识别都必然二选一或判歧义。判歧义在 fail-closed 下
+ * 会阻断目标客户端自己的全部流量。所以：
+ *
+ *   ① 已知前缀（WIRE_ROUTE_PREFIXES）→ 直接决定线格式，不投票；
+ *   ② 无权威前缀时才看正文，且用**互斥**判别键，最后落 chat（倾向已支持格式而非判未知）；
+ *   ③ 两者都不命中 → unknown（只可能是真正无法归类的 body）。
+ *
+ * 识别是**纯数据分类，不抛异常**（设计 D3a）：坏输入返回 unknown，而不是让异常冒泡成
+ * "checker error → block" 那条无度量的失败路径。
+ */
+
+/** 路由前缀 → 线格式。前缀是**第一段**路径（`<gw>/<prefix>/<provider>/...`）。 */
+export const WIRE_ROUTE_PREFIXES: ReadonlyMap<string, WireFormat> = Object.freeze(
+  new Map<string, WireFormat>([
+    ["claude", "anthropic-messages"],
+    ["codex", "openai-responses"],
+    ["promptfoo", "chat"],
+    ["opencode", "chat"],
+    ["delphi", "chat"],
+    ["dsh", "chat"],
+  ]),
+);
+
+export { protocolFor };
+
+/** 前缀 → 线格式；未知前缀返回 undefined（= 没有权威）。 */
+export function formatForPrefix(prefix: string | null | undefined): WireFormat | undefined {
+  if (!prefix) return undefined;
+  return WIRE_ROUTE_PREFIXES.get(prefix);
+}
+
+function isObject(v: unknown): v is Record<string, unknown> {
+  return typeof v === "object" && v !== null && !Array.isArray(v);
+}
+
+/** Responses 的特征键：出现任一个即足以归类（与 messages 不冲突，因为 Claude 不带这些键）。 */
+function looksLikeResponses(parsed: Record<string, unknown>, direction: Direction): boolean {
+  if (direction === "response") return parsed.object === "response" || Array.isArray(parsed.output);
+  return parsed.input !== undefined || parsed.output !== undefined || parsed.instructions !== undefined;
+}
+
+/** Anthropic 响应/帧特征：帧类型前缀集合。 */
+const ANTHROPIC_FRAME_PREFIXES = ["content_block", "message_start", "message_delta"] as const;
+
+function frameTypeOf(parsed: Record<string, unknown>): string {
+  return typeof parsed.type === "string" ? parsed.type : "";
+}
+
+function looksLikeAnthropicResponse(parsed: Record<string, unknown>): boolean {
+  const t = frameTypeOf(parsed);
+  if (t === "message" && Array.isArray(parsed.content)) return true;
+  return ANTHROPIC_FRAME_PREFIXES.some((prefix) => t.startsWith(prefix));
+}
+
+/** 请求侧流式帧：带自己 type、且既不是 chat 体也不是 responses 帧。 */
+function looksLikeAnthropicFrame(parsed: Record<string, unknown>): boolean {
+  const t = frameTypeOf(parsed);
+  const isFrame = t.length > 0 && parsed.choices === undefined && parsed.messages === undefined;
+  if (!isFrame || t.startsWith("response.")) return false;
+  return ANTHROPIC_FRAME_PREFIXES.some((prefix) => t.startsWith(prefix));
+}
+
+/** 消息里是否有 tool_use / tool_result 块（Anthropic 独有的块类型）。 */
+function hasAnthropicToolBlocks(messages: unknown): boolean {
+  if (!Array.isArray(messages)) return false;
+  const isToolBlock = (seg: unknown): boolean => isObject(seg) && (seg.type === "tool_use" || seg.type === "tool_result");
+  return messages.some((m: unknown) => isObject(m) && Array.isArray(m.content) && m.content.some(isToolBlock));
+}
+
+function looksLikeAnthropicRequest(parsed: Record<string, unknown>): boolean {
+  if (looksLikeAnthropicFrame(parsed)) return true;
+  return Array.isArray(parsed.system) || hasAnthropicToolBlocks(parsed.messages);
+}
+
+/** Anthropic 特征：块数组 system、tool_use/tool_result 块，或 Anthropic 帧类型。 */
+function looksLikeAnthropic(parsed: Record<string, unknown>, direction: Direction): boolean {
+  return direction === "response" ? looksLikeAnthropicResponse(parsed) : looksLikeAnthropicRequest(parsed);
+}
+
+/** 是否有"看起来像 chat"的迹象（判别键用完之后的兜底）。 */
+function looksLikeChatLike(parsed: Record<string, unknown>, direction: Direction): boolean {
+  if (direction === "response") {
+    const t = typeof parsed.type === "string" ? parsed.type : "";
+    if (t.startsWith("response.")) return false;
+    return Array.isArray(parsed.choices);
+  }
+  return Array.isArray(parsed.messages);
+}
+
+/**
+ * 识别线格式。
+ * @param direction 请求或响应
+ * @param parsed 已解析的 JSON（不可解析时传 null）
+ * @param routePrefix 路由前缀（`<gw>/<prefix>/...` 的第一段）；无权威时传 null/undefined
+ */
+function recognizeResponse(body: Record<string, unknown>): RecognizedFormat {
+  if (frameTypeOf(body).startsWith("response.")) return { kind: "known", format: "openai-responses" };
+  return recognizeBody(body, "response");
+}
+
+function recognizeBody(body: Record<string, unknown>, direction: Direction): RecognizedFormat {
+  if (looksLikeResponses(body, direction)) return { kind: "known", format: "openai-responses" };
+  if (looksLikeAnthropic(body, direction)) return { kind: "known", format: "anthropic-messages" };
+  if (looksLikeChatLike(body, direction)) return { kind: "known", format: "chat" };
+  return { kind: "unknown" };
+}
+
+/**
+ * 识别线格式。
+ * @param direction 请求或响应
+ * @param parsed 已解析的 JSON（不可解析时传 null）
+ * @param routePrefix 路由前缀（`<gw>/<prefix>/...` 的第一段）；无权威时传 null/undefined
+ */
+export function recognize(direction: Direction, parsed: unknown, routePrefix?: string | null): RecognizedFormat {
+  const authoritative = formatForPrefix(routePrefix);
+  if (authoritative) return { kind: "known", format: authoritative };
+  if (!isObject(parsed)) return { kind: "unknown" };
+  return direction === "response" ? recognizeResponse(parsed) : recognizeBody(parsed, "request");
+}
+
+/** `parseRoute` 用：给定首段路径返回与之绑定的线格式（未绑定时 undefined）。 */
+export function boundFormatForPath(firstSegment: string | null): WireFormat | undefined {
+  return formatForPrefix(firstSegment);
+}
+
+/** 供测试与文档列出全部已绑定前缀。 */
+export function wireRoutePrefixes(): readonly string[] {
+  return [...WIRE_ROUTE_PREFIXES.keys()];
+}
diff --git a/src/gateway/protocols/responses.ts b/src/gateway/protocols/responses.ts
new file mode 100644
index 0000000..5bf3b92
--- /dev/null
+++ b/src/gateway/protocols/responses.ts
@@ -0,0 +1,220 @@
+// @no-test-required: 测试在 tests/unit/gateway/protocols/responses.test.ts（本项目测试布局为 tests/ 目录；Gate 5a 仅识别同目录/根 tests/ 六种路径）
+import type { CoverageSpec, Projection, WireProtocol } from "./types.ts";
+
+/**
+ * @test REQ-V2bA-01 / AC-V2bA-01a~b
+ * @intent OpenAI Responses 协议投影（Codex 的线格式；`wire_api="responses"` 是唯一支持值）。
+ *
+ * 改动前的盲区（实测，见 var/probes/scan-unit-probe.mjs）：
+ *   请求侧只有 `tools` 进扫描单元——`instructions`、`input[]`（`input_text` /
+ *   `function_call.arguments` / `function_call_output.output`）全不可见；
+ *   响应侧 **投影为空字符串**——`output[]` 的 `output_text` 与 `function_call.arguments` 全不可见。
+ *
+ * 形态要点：
+ *   - `input` 可为**字符串**或数组（数组元素按 `type` 分派）；
+ *   - 两代 Responses 形态并存，故 `output[]` 的元素既可能是 `message/content[]` 也可能是扁平文本字段。
+ *
+ * 实现要点：每个元素的投影拆成若干小函数，避免深层嵌套（Clean Code 门限 4 层）。
+ */
+
+function isObject(v: unknown): v is Record<string, unknown> {
+  return typeof v === "object" && v !== null && !Array.isArray(v);
+}
+
+/** 字符串直接入投影；对象走 JSON 规范化并报告"派生"。返回是否派生。 */
+function pushPayload(value: unknown, parts: string[]): boolean {
+  if (typeof value === "string") {
+    parts.push(value);
+    return false;
+  }
+  if (value === undefined) return false;
+  parts.push(JSON.stringify(value));
+  return true;
+}
+
+/** content[] 的单个块：字符串 / `{text}` / `{arguments}`。 */
+function pushOneContentBlock(c: unknown, parts: string[]): boolean {
+  if (typeof c === "string") {
+    parts.push(c);
+    return false;
+  }
+  if (!isObject(c)) return false;
+  if (typeof c.text === "string") {
+    parts.push(c.text);
+    return false;
+  }
+  return c.arguments === undefined ? false : pushPayload(c.arguments, parts);
+}
+
+/** content[] 块：字符串 / `{text}` / `{arguments}`。 */
+function pushContentBlocks(blocks: unknown, parts: string[]): boolean {
+  if (!Array.isArray(blocks)) return false;
+  let derived = false;
+  for (const c of blocks) derived = pushOneContentBlock(c, parts) || derived;
+  return derived;
+}
+
+/** summary[] 的 `{text}`。 */
+function pushSummary(summary: unknown, parts: string[]): void {
+  if (!Array.isArray(summary)) return;
+  for (const s of summary) if (isObject(s) && typeof s.text === "string") parts.push(s.text);
+}
+
+/** output 字段：字符串或块数组。 */
+function pushOutputField(output: unknown, parts: string[]): void {
+  if (typeof output === "string") {
+    parts.push(output);
+    return;
+  }
+  pushContentBlocks(output, parts);
+}
+
+/** 元素的标量文本字段：扁平 text（两代 Responses 形态并存）。 */
+function pushItemText(it: Record<string, unknown>, parts: string[]): void {
+  if (typeof it.name === "string") parts.push(it.name);
+  if (typeof it.text === "string") parts.push(it.text);
+}
+
+/** 单个 input/output 元素的投影。返回是否产生派生文本。 */
+function pushItem(it: unknown, parts: string[]): boolean {
+  if (typeof it === "string") {
+    parts.push(it);
+    return false;
+  }
+  if (!isObject(it)) return false;
+  const fromContent = pushContentBlocks(it.content, parts);
+  pushItemText(it, parts);
+  const fromArgs = it.arguments === undefined ? false : pushPayload(it.arguments, parts);
+  pushOutputField(it.output, parts);
+  pushSummary(it.summary, parts);
+  return fromContent || fromArgs;
+}
+
+/** input / output 整体投影（字符串或数组）。 */
+function pushItems(items: unknown, parts: string[]): boolean {
+  if (typeof items === "string") {
+    parts.push(items);
+    return false;
+  }
+  if (!Array.isArray(items)) return false;
+  let derived = false;
+  for (const it of items) derived = pushItem(it, parts) || derived;
+  return derived;
+}
+
+/** 元素字段 → 是否"存在即算该 handled 路径"（与 pushItem 的可见面一一对应）。 */
+const ITEM_HANDLED: ReadonlyArray<readonly [string, (v: unknown) => boolean]> = Object.freeze([
+  ["content", Array.isArray],
+  ["name", (v: unknown) => typeof v === "string"],
+  ["arguments", (v: unknown) => v !== undefined],
+  ["output", (v: unknown) => v !== undefined],
+  ["summary", Array.isArray],
+  ["text", (v: unknown) => typeof v === "string"],
+]);
+
+function markOneItem(it: unknown, prefix: string, handled: Set<string>): void {
+  if (!isObject(it)) return;
+  for (const [field, present] of ITEM_HANDLED) if (present(it[field])) handled.add(`${prefix}[].${field}`);
+}
+
+/** 登记 handled 路径（与 pushItem 的可见面一一对应）。 */
+function markHandledItems(items: unknown, prefix: string, handled: Set<string>): void {
+  if (typeof items === "string") {
+    handled.add(prefix);
+    return;
+  }
+  if (!Array.isArray(items)) return;
+  for (const it of items) markOneItem(it, prefix, handled);
+}
+
+function projectRequest(parsed: Record<string, unknown>): Projection {
+  const parts: string[] = [];
+  const handled = new Set<string>();
+  let derived = false;
+  if (typeof parsed.instructions === "string") {
+    parts.push(parsed.instructions);
+    handled.add("instructions");
+  }
+  if (parsed.input !== undefined) {
+    derived = pushItems(parsed.input, parts) || derived;
+    markHandledItems(parsed.input, "input", handled);
+    handled.add("input");
+  }
+  if (Array.isArray(parsed.tools)) {
+    parts.push(JSON.stringify(parsed.tools));
+    handled.add("tools");
+    derived = true;
+  }
+  return { parts, derived, handled: [...handled], present: [] };
+}
+
+function projectResponse(parsed: Record<string, unknown>, _requestedModel: string | null): Projection {
+  const parts: string[] = [];
+  const handled = new Set<string>();
+  let derived = false;
+  if (parsed.output !== undefined) {
+    derived = pushItems(parsed.output, parts);
+    markHandledItems(parsed.output, "output", handled);
+    handled.add("output");
+  }
+  return { parts, derived, handled: [...handled], present: [] };
+}
+
+/**
+ * SL-04（AC-V2bA-01c）：Responses 流式帧投影。
+ *
+ * 帧类型（官方 SSE）：`response.created` / `response.output_item.added`（无文本）/
+ * `response.output_text.delta`（`delta` 字符串）/ `response.function_call_arguments.delta`
+ * 与 **`…done`**（`done` 帧带完整 `arguments`，不能只靠 delta 拼接）/
+ * `response.reasoning_summary_text.delta` / `response.completed`（带 `response.usage`）。
+ * 心跳/元数据帧投影为空串（合法常态，不计入 present）。
+ */
+function projectFrame(parsed: Record<string, unknown>): Projection {
+  const parts: string[] = [];
+  const handled: string[] = [];
+  let derived = false;
+  if (typeof parsed.delta === "string") {
+    parts.push(parsed.delta);
+    handled.push("delta");
+  }
+  if (typeof parsed.name === "string") {
+    parts.push(parsed.name);
+    handled.push("name");
+  }
+  if (parsed.arguments !== undefined) {
+    derived = pushPayload(parsed.arguments, parts);
+    handled.push("arguments");
+  }
+  if (Array.isArray(parsed.summary)) {
+    pushSummary(parsed.summary, parts);
+    handled.push("summary");
+  }
+  return { parts, derived, handled, present: [] };
+}
+
+export const RESPONSES_COVERAGE: CoverageSpec = Object.freeze({
+  requestPayloadPaths: Object.freeze([
+    "instructions",
+    "input",
+    "input[].content",
+    "input[].arguments",
+    "input[].output",
+    "tools",
+  ]) as readonly string[],
+  responsePayloadPaths: Object.freeze([
+    "output",
+    "output[].content",
+    "output[].arguments",
+    "output[].summary",
+    "output[].text",
+  ]) as readonly string[],
+});
+
+export const responsesProtocol: WireProtocol = Object.freeze({
+  format: "openai-responses" as const,
+  coverage: RESPONSES_COVERAGE,
+  projectRequest,
+  projectResponse,
+  projectFrame,
+  canaryInjection: false,
+});
diff --git a/src/gateway/protocols/table.ts b/src/gateway/protocols/table.ts
new file mode 100644
index 0000000..4dac489
--- /dev/null
+++ b/src/gateway/protocols/table.ts
@@ -0,0 +1,25 @@
+// @no-test-required: 测试在 tests/unit/gateway/protocols/registry.test.ts（本项目测试布局为 tests/ 目录；Gate 5a 仅识别同目录/根 tests/ 六种路径）
+import { chatProtocol } from "./chat.ts";
+import { anthropicMessagesProtocol } from "./anthropic.ts";
+import { responsesProtocol } from "./responses.ts";
+import type { WireFormat, WireProtocol } from "./types.ts";
+
+/**
+ * 已实装投影器的协议表。
+ *
+ * 为什么独立成模块：它一度写在 registry.ts 里，而 registry 又被 scan-unit 引用、
+ * scan-unit 又被 core 引用，形成 `registry → chat → scan-unit → registry` 的环。
+ * 环本身不报错，但**运行期解析到的是空表**——识别成功、查表失败，
+ * 于是每条正常请求都被判成"没有投影器"而阻断。把它拆出来后依赖变成单向：
+ * table → 各协议 → (types)，registry → table。
+ */
+export const PROTOCOL_TABLE: ReadonlyMap<WireFormat, WireProtocol> = new Map<WireFormat, WireProtocol>([
+  ["chat", chatProtocol],
+  ["anthropic-messages", anthropicMessagesProtocol],
+  ["openai-responses", responsesProtocol],
+]);
+
+/** 取某个线格式的协议实现；未实装返回 undefined。 */
+export function protocolFor(format: WireFormat): WireProtocol | undefined {
+  return PROTOCOL_TABLE.get(format);
+}
diff --git a/src/gateway/protocols/types.ts b/src/gateway/protocols/types.ts
new file mode 100644
index 0000000..210ad1c
--- /dev/null
+++ b/src/gateway/protocols/types.ts
@@ -0,0 +1,88 @@
+/**
+ * @test REQ-V2bA-03 / REQ-V2bA-04 / REQ-V2bA-14
+ * @intent 协议线格式（wire format）的类型契约。
+ *
+ * 立此文件的理由（R2 评审 C2）："该协议的已知载荷字段是否都被投影了"这件事，
+ * 不能由投影器自己声明——投影器忘了某个字段时，它照样会说自己"覆盖了"。
+ * 因此把权威清单变成**协议声明的数据**（CoverageSpec），由调用方拿清单与投影器
+ * 上报的 handled 求差集，得到与文本量无关的覆盖结论。
+ *
+ * 三个取值域都是封闭的，新增取值必须同步 specification.yaml 与文档。
+ */
+
+/** 网关能识别的线格式。新增一种必须同时加 CoverageSpec 与正负样本矩阵。 */
+export type WireFormat = "chat" | "anthropic-messages" | "openai-responses";
+
+/** 识别结果：只有两态。覆盖结果不在这个轴上（见 CoverageVerdict）。 */
+export type RecognizedFormat = { readonly kind: "known"; readonly format: WireFormat } | { readonly kind: "unknown" };
+
+/** 轴2：覆盖结论。与"有没有文本"无关，只看 present/handled 两个集合。 */
+export type CoverageVerdict =
+  /** present 非空且全部被处理 —— 正常判定。 */
+  | "full"
+  /** 有已知载荷字段没被投影器处理 —— 受管路由 fail-closed。 */
+  | "partial"
+  /** 一个已知载荷字段都没出现 —— 受管路由 fail-closed。 */
+  | "vacuous";
+
+/** evidence 顶层 reason 的封闭枚举（与既有 registry_unavailable / inject_skipped 并列）。 */
+export type CoverageReason = "shape_unrecognized" | "shape_known_empty" | "shape_partial_coverage";
+
+/**
+ * 一个协议"已知载荷字段"的权威清单。
+ *
+ * 路径语法：点号分隔的键路径；数组中出现的元素记为 `key[]`；元素内部的键继续用点号串接
+ * （例如 `messages[].content[].text`）。**只登记会被扫描的载荷**，结构性字段
+ * （model / usage / finish_reason）不登记——它们进 meta，不进文本投影。
+ */
+export interface CoverageSpec {
+  readonly requestPayloadPaths: readonly string[];
+  readonly responsePayloadPaths: readonly string[];
+}
+
+/** 投影结果：文本片段 + 派生标记 + 覆盖上报。 */
+export interface Projection {
+  /** 交给 checker 的文本片段（调用方用既有分隔符拼接）。 */
+  readonly parts: readonly string[];
+  /**
+   * 片段中**存在规范化产物**（对象转 JSON 等），其 offsets 不指回原文（REQ-05）。
+   * 调用方不得把派生片段的 offsets 当成原文位置。
+   */
+  readonly derived: boolean;
+  /** 本次投影实际处理过的载荷路径（来自 CoverageSpec 的同一套路径语法）。 */
+  readonly handled: readonly string[];
+  /** 原始 body 中**存在**的已知载荷路径（由调用方用 CoverageSpec 求得后回填）。 */
+  readonly present: readonly string[];
+}
+
