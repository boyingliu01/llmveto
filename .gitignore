# Dependencies
node_modules/

# Build output
dist/
build/

# Test coverage (xp-gate pre-commit hook reads coverage/coverage-summary.json)
coverage/

# Local runtime state (gateway pid/log/state)
.llmveto/

# Evidence store (may contain sensitive request metadata) — never commit
var/evidence/

# Sprint worktrees (isolated dev branches)
.worktrees/

# xp-gate hook artifacts (local quality-gate reports/history, not project state)
.xp-gate/
.quality-history.jsonl

# Agent harness residue (local run continuation state, not project state)
.omo/

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Secrets — the gateway scans for these, it must never store them
.env
.env.*
!.env.example
*.pem
*.key
