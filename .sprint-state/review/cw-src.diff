+  const handled = new Set<string>();
+  let derived = false;
+  if (parsed.content !== undefined) {
+    handled.add("content");
+    derived = pushBlocks(parsed.content, parts);
+    markHandledBlocks(parsed.content, "content[]", handled);
+  }
+  return { parts, derived, handled: [...handled], present: [] };
